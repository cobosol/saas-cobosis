        "css_template": ".card { background: #f0f0f0; padding: 20px; }",
        "fields_schema": {
          "fields": [
            {"name": "titulo", "type": "text", "label": "Título", "required": true},
            {"name": "descripcion", "type": "textarea", "label": "Descripción"},
            {"name": "fecha", "type": "date", "label": "Fecha del evento"},
            {"name": "lugar", "type": "text", "label": "Lugar"}
          ]
        },
        "allowed_variables": ["titulo", "descripcion", "fecha", "lugar"]
      }
    }
  ]